# Example credentials file for app-suite.service.
#
# On the server: copy to /opt/app-suite/app-suite.env, set 0600 permissions,
# and fill in real values. This example file is the only *.env tracked in git;
# real .env files are gitignored.
#
#   cp app-suite.env.example /opt/app-suite/app-suite.env
#   chmod 600 /opt/app-suite/app-suite.env

# Admin login password. Use a strong, unique value.
APPSUITE_ADMIN_PASSWORD=change-me-to-a-strong-password

# Session cookie secret. Generate e.g.:  openssl rand -base64 32
# If unset, the server generates a random secret on each restart, which
# invalidates existing admin sessions.
APPSUITE_SESSION_SECRET=change-me-to-a-random-base64-secret
